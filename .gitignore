# Python bytecode and test/lint caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
reports/

# Local virtual environments and package/build output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local secrets (keep a sanitized .env.example tracked, if used)
.env
.env.*
!.env.example
*.pem
*.key

# Large or restricted source material. Keep provenance/manifests and
# redistributable metadata under data/raw/ and data/cleaned/ tracked.
data/audio/
data/clips/
data/references/
data/private/

# Editor/OS noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Office lock files (created while a .pptx/.docx/.xlsx is open)
~$*

# Colab handoff bundle: rebuild with lyrics-asr-package-colab
colab_handoff/colab_bundle.zip
colab_handoff/final_predictions/
colab_handoff/reports/
colab_handoff/__pycache__/
.claudeignore
.claude/
